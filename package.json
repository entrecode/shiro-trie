{
  "name": "shiro-trie",
  "version": "0.4.10",
  "description": "Check permissions using Shiro-like strings, put in a trie.",
  "homepage": "https://github.com/entrecode/shiro-trie",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts"
  ],
  "author": {
    "name": "Ruben Deyhle",
    "email": "deyhle@entrecode.de",
    "url": "https://entrecode.de"
  },
  "repository": "https://github.com/entrecode/shiro-trie",
  "license": "MIT",
  "keywords": [
    "shiro-trie",
    "shiro",
    "trie",
    "authorization",
    "permissions"
  ],
  "devDependencies": {
    "conventional-changelog-cli": "^2.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "conventional-changelog -i CHANGELOG.md -s"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.cjs"
    ]
  }
}
